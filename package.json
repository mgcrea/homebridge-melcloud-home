{
  "name": "@mgcrea/homebridge-melcloud-home",
  "displayName": "MELCloud Home",
  "version": "0.1.3",
  "description": "Homebridge plugin for Mitsubishi Electric air conditioners on the MELCloud Home platform",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/homebridge-melcloud-home.git"
  },
  "homepage": "https://github.com/mgcrea/homebridge-melcloud-home#readme",
  "bugs": "https://github.com/mgcrea/homebridge-melcloud-home/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "melcloud",
    "melcloud-home",
    "mitsubishi",
    "mitsubishi-electric",
    "air-conditioner",
    "heat-pump"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src/ test/ scripts/",
    "lint:fix": "oxlint --fix src/ test/ scripts/",
    "format": "oxfmt --write src/ test/ scripts/",
    "format:check": "oxfmt --check src/ test/ scripts/",
    "check": "tsc --noEmit",
    "spec": "vitest --run",
    "coverage": "vitest --run --coverage",
    "watch": "vitest",
    "probe": "tsx scripts/probe.ts",
    "dev:homebridge": "homebridge -D -U ./.homebridge -P . --strict-plugin-resolution",
    "test": "pnpm run lint && pnpm run check && pnpm run spec && pnpm run format:check",
    "release": "release-it",
    "prepublishOnly": "pnpm run test && pnpm run build"
  },
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.10.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "homebridge": "^2.2.1",
    "msw": "^2.12.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "release-it": "^21.0.1",
    "tsdown": "^0.21.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}
